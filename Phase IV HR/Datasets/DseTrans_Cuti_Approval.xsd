                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="False">
                    <CommandText>SELECT        tbltrans_cuti_pengajuan.`primary`, tbltrans_cuti_pengajuan.`no transaksi`, tbltrans_cuti_pengajuan.urutan, tbltrans_cuti_pengajuan.tanggal, 
                         tbltrans_cuti_pengajuan.`primary karyawan`, tbltrans_cuti_pengajuan.`primary job position`, tbltrans_cuti_pengajuan.`primary cuti`, 
                         tbltrans_cuti_pengajuan.status, tbltrans_cuti_pengajuan.`status notes`, tbltrans_cuti_pengajuan.`approved by`, tbltrans_cuti_pengajuan.`approved date`, 
                         tbltrans_cuti_pengajuan.`start date`, tbltrans_cuti_pengajuan.`half day start`, tbltrans_cuti_pengajuan.`end date`, tbltrans_cuti_pengajuan.`half day end`, 
                         tbltrans_cuti_pengajuan.duration, tbltrans_cuti_pengajuan.reason, tbltrans_cuti_pengajuan.`created by`, tbltrans_cuti_pengajuan.`created date`, 
                         tbltrans_cuti_pengajuan.`modified by`, tbltrans_cuti_pengajuan.`modified date`, tbltrans_cuti_pengajuan.`timestamp`, 
                         tblmaster_karyawan.Code AS `Kode Karyawan`, tblmaster_jobposition.code AS `Kode Job Position`, tblmaster_karyawan.`Full Name`, 
                         CONCAT(tblmaster_cuti.code, ' - ', tblmaster_cuti.`desc`) AS CodeCuti, tblmaster_cuti_item.balance
FROM            tbltrans_cuti_pengajuan INNER JOIN
                         tblmaster_karyawan ON tbltrans_cuti_pengajuan.`primary karyawan` = tblmaster_karyawan.`Primary` INNER JOIN
                         tblmaster_jobposition ON tbltrans_cuti_pengajuan.`primary job position` = tblmaster_jobposition.`primary` INNER JOIN
                         tblmaster_cuti_item ON tbltrans_cuti_pengajuan.`primary karyawan` = tblmaster_cuti_item.`primary karyawan` AND 
                         tbltrans_cuti_pengajuan.`primary cuti` = tblmaster_cuti_item.`primary leave` INNER JOIN
                         tblmaster_cuti ON tblmaster_cuti_item.`primary leave` = tblmaster_cuti.`primary`</CommandText>
