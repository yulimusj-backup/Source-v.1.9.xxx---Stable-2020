                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="True">
                    <CommandText>SELECT        tblmaster_product.`Primary` AS `Primary Product`, tblmaster_product.`Product Code`, tblmaster_product.Description, tblmaster_master_unit.`Unit Code`, 
                         tblmaster_category.`Category Code`, tblmaster_category.Description AS `Category Desc`, IFNULL(SUM(tblmaster_productqty.Qty), 0) AS `Qty On Hand`
FROM            tblmaster_product INNER JOIN
                         tblmaster_master_unit ON tblmaster_product.`Primary Unit` = tblmaster_master_unit.`Primary` INNER JOIN
                         tblmaster_category ON tblmaster_product.`Primary Category` = tblmaster_category.`Primary` LEFT OUTER JOIN
                         tblmaster_productqty ON tblmaster_product.`Primary` = tblmaster_productqty.`Primary Product`
GROUP BY tblmaster_category.Description, tblmaster_category.`Category Code`, tblmaster_master_unit.`Unit Code`, tblmaster_product.Description, 
                         tblmaster_product.`Product Code`, tblmaster_product.`Primary`
ORDER BY `Primary Product`</CommandText>
