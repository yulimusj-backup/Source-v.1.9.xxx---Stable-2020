                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="True">
                    <CommandText>SELECT        tbltransaksi_stockbundling_item_downtime.`primary downtime` AS `Primary Down Time`, tblmaster_downtime.`Down Time Code`, tblmaster_downtime.Description AS `Down Time Desc`, 
                         tbltransaksi_stockbundling_item_downtime.`primary bundling` AS `Primary Bundling`, tbltransaksi_stockbundling.`Tanggal Transaksi` AS `Tanggal Bundling`, 
                         tbltransaksi_stockbundling.`identifier wo` AS `Identifier WO`, tbltrans_mo_item_wo.`Primary Product`, tblmaster_product.`Product Code`, tblmaster_product.Description AS `Product Desc`, 
                         tbltrans_mo_item_wo.`WO Number` AS `WO No`, tbltrans_mo_item_wo.`Primary Process`, tblmaster_proses.Code AS `Process Code`, tblmaster_proses.`Desc` AS `Process Desc`, 
                         tbltrans_mo_item_wo.`Primary Work Unit`, tblmaster_workunit.`work unit code` AS `Work Unit Code`, tblmaster_workunit.description AS `Work Unit Desc`, 
                         tbltransaksi_stockbundling_item_downtime.duration AS `Down Time Duration`, tblmaster_product.`Primary Category`, tblmaster_category.`Parent Group Primary` AS `Primary Sub Brand`, 
                         tblmaster_product_group.`Parent Group Primary` AS `Primary Brand`, tblmaster_product_group_1.`Parent Group Primary` AS `Primary Group`, tbltrans_mo.`MO Number` AS `MO No`, 
                         tbltrans_mo.`Primary` AS `Primary MO`
FROM            tblmaster_downtime INNER JOIN
                         tbltransaksi_stockbundling_item_downtime ON tblmaster_downtime.`Primary` = tbltransaksi_stockbundling_item_downtime.`primary downtime` INNER JOIN
                         tbltransaksi_stockbundling ON tbltransaksi_stockbundling_item_downtime.`primary bundling` = tbltransaksi_stockbundling.`Primary` INNER JOIN
                         tbltrans_mo_item_wo ON tbltransaksi_stockbundling.`identifier wo` = tbltrans_mo_item_wo.Identifier INNER JOIN
                         tblmaster_product ON tbltrans_mo_item_wo.`Primary Product` = tblmaster_product.`Primary` INNER JOIN
                         tblmaster_proses ON tbltrans_mo_item_wo.`Primary Process` = tblmaster_proses.`Primary` INNER JOIN
                         tblmaster_workunit ON tbltrans_mo_item_wo.`Primary Work Unit` = tblmaster_workunit.`primary` INNER JOIN
                         tblmaster_category ON tblmaster_product.`Primary Category` = tblmaster_category.`Primary` INNER JOIN
                         tblmaster_product_group ON tblmaster_category.`Parent Group Primary` = tblmaster_product_group.`Primary` INNER JOIN
                         tblmaster_product_group tblmaster_product_group_1 ON tblmaster_product_group.`Parent Group Primary` = tblmaster_product_group_1.`Primary` INNER JOIN
                         tbltrans_mo ON tbltrans_mo_item_wo.`Primary MO` = tbltrans_mo.`Primary`
WHERE        (tbltransaksi_stockbundling.`Tanggal Transaksi` &gt;= @bundling_from AND tbltransaksi_stockbundling.`Tanggal Transaksi` &lt;= @bundling_to)
ORDER BY tblmaster_downtime.`Down Time Code`, `Tanggal Bundling`, `MO No`, tblmaster_product.`Product Code`, `WO No`</CommandText>
