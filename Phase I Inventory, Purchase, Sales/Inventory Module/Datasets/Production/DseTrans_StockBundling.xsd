                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="False">
                    <CommandText>SELECT        tbltransaksi_stockbundling_item_before.`Secondary Qty`, SUM(tbltransaksi_stockbundling_item_before.Qty) AS Qty, 
