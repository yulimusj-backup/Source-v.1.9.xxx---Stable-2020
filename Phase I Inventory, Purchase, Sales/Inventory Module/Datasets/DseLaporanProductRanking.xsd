                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="True">
                    <CommandText>SELECT        tbltransaksi_stockinout_item.`Primary Product`, tblmaster_product_group.`Group Code` AS Brand, tblmaster_category.`Category Code`, 
                         tblmaster_product.`Product Code`, tblmaster_product.Description, SUM(tbltransaksi_stockinout_item.Qty) AS Qty, tblmaster_master_unit.`Unit Code`, 
                         tblmaster_category.Description AS `Category Desc`, tblmaster_product_group.Description AS `Brand Desc`
FROM            tbltransaksi_stockinout INNER JOIN
                         tbltransaksi_stockinout_item ON tbltransaksi_stockinout.`Primary` = tbltransaksi_stockinout_item.`Primary Transaksi` INNER JOIN
                         tblmaster_master_unit ON tbltransaksi_stockinout_item.`Primary Units` = tblmaster_master_unit.`Primary` INNER JOIN
                         tblmaster_product ON tbltransaksi_stockinout_item.`Primary Product` = tblmaster_product.`Primary` INNER JOIN
                         tblmaster_category ON tblmaster_product.`Primary Category` = tblmaster_category.`Primary` INNER JOIN
                         product_sub_brand_view ON tblmaster_category.`Parent Group Primary` = product_sub_brand_view.`Primary Sub Brand` INNER JOIN
                         tblmaster_product_group ON product_sub_brand_view.`Primary Brand` = tblmaster_product_group.`Primary`
WHERE        (tbltransaksi_stockinout.`Tanggal Transaksi` &lt;= @TanggalSampai) AND (tbltransaksi_stockinout.`Tanggal Transaksi` &gt;= @TanggalDari) AND 
                         (tbltransaksi_stockinout.`Tipe Transaksi` = 3 OR
                         tbltransaksi_stockinout.`Tipe Transaksi` = 4 OR
                         tbltransaksi_stockinout.`Tipe Transaksi` = 5 OR
                         tbltransaksi_stockinout.`Tipe Transaksi` = 8)
GROUP BY tbltransaksi_stockinout_item.`Primary Product`, tblmaster_master_unit.`Unit Code`, tblmaster_product.`Product Code`, tblmaster_product.Description, 
                         tblmaster_category.`Category Code`, tblmaster_product_group.`Group Code`, tblmaster_category.Description, tblmaster_product_group.Description
ORDER BY Brand, tblmaster_category.`Category Code`, Qty DESC</CommandText>
