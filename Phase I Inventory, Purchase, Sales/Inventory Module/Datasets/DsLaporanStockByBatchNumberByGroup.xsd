                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="True">
                    <CommandText>SELECT        tblmaster_product.`Product Code` AS `Code Number`, tblmaster_product.`Batch No Controlled` AS `Batch Number`, tblmaster_product.Description, 
                         SUM(tblmaster_productqty.Qty) AS `Qty Per Batch`, tblmaster_product.`Primary`, tblmaster_master_unit.Description AS Unit, 
                         tblmaster_category.`Category Code`, tblmaster_category.Description AS Desc_Code
FROM            tblmaster_productqty INNER JOIN
                         tblmaster_product ON tblmaster_productqty.`Primary Product` = tblmaster_product.`Primary` INNER JOIN
                         tblmaster_master_unit ON tblmaster_product.`Primary Unit` = tblmaster_master_unit.`Primary` INNER JOIN
                         tblmaster_category ON tblmaster_product.`Primary Category` = tblmaster_category.`Primary`
WHERE        (tblmaster_productqty.`Primary` = @PrimaryProduct)
GROUP BY tblmaster_product.`Product Code`, tblmaster_product.`Batch No Controlled`, tblmaster_product.Description, tblmaster_product.`Primary`, 
                         tblmaster_master_unit.Description, tblmaster_category.`Category Code`, tblmaster_category.Description
ORDER BY `Code Number`, `Batch Number`</CommandText>
