                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="True">
                    <CommandText>SELECT tblmaster_product.`Decimal`, tbltrans_salesreturn_item.`Primary Product`, SUM(tbltrans_salesreturn_item.`Total Qty`) AS Qty, tblmaster_product.`Primary Unit`, 
                  tbltrans_do.`Primary Invoice` AS `Primary Invoice Sales`, tbltrans_salesreturn.`Primary` AS `Primary SR`, tbltrans_do.`Tanggal Transaksi` AS `Do Date`
FROM     tbltransaksi_stockinout INNER JOIN
                  tbltrans_do ON tbltransaksi_stockinout.`Primary DO Sales` = tbltrans_do.`Primary` INNER JOIN
                  tbltrans_salesreturn ON tbltransaksi_stockinout.`Primary` = tbltrans_salesreturn.`Primary Stock In Sales Return` INNER JOIN
                  tbltrans_salesreturn_item ON tbltrans_salesreturn.`Primary` = tbltrans_salesreturn_item.`Primary Transaksi` INNER JOIN
                  tblmaster_product ON tbltrans_salesreturn_item.`Primary Product` = tblmaster_product.`Primary`
