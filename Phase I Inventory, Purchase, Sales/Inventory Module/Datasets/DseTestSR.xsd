                  (tbltrans_salesreturn.`Tanggal Transaksi` &gt;= @TanggalDari) AND (tbltrans_do.`Tanggal Transaksi` &gt; @TanggalConvertionDate)
GROUP BY tblmaster_product.`Decimal`, tbltrans_salesreturn_item.`Primary Product`, tblmaster_product.`Primary Unit`, tbltrans_do.`Primary Invoice`, 
