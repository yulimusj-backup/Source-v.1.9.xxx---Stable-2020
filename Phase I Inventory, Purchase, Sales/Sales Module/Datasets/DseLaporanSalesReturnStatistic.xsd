                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="True">
                    <CommandText>SELECT        tblmaster_customer.`Customer Code`, tblmaster_customer.`Customer Name`, tbltrans_salesreturn.`Primary`, 
                         tbltrans_salesreturn.`No Transaksi` AS `Sales Return Number`, tbltrans_salesreturn.`Tanggal Transaksi`, tbltrans_salesreturn_item.`Primary Product`, 
                         tbltrans_salesreturn_item.`Total Qty`, tbltrans_salesreturn_item.Discount, tbltrans_salesreturn_item.`Nett Price`, tbltrans_salesreturn_item.`Exchange Rate`, 
                         tbltrans_salesreturn.`Primary Currency`, tbltrans_salesreturn.`Tax Exchange Rate`, tbltrans_salesreturn.`Tipe SR`, 
                         tblmaster_customer_sales_area.`Sales Area Code`, tblmaster_customer_sales_area.Description AS `Sales Area Desc`, 
                         tblmaster_customer_segmentation.`Segmentation Code`, tblmaster_customer_segmentation.Description AS `Segmentasi Desc`
FROM            tbltrans_salesreturn INNER JOIN
                         tbltrans_salesreturn_item ON tbltrans_salesreturn.`Primary` = tbltrans_salesreturn_item.`Primary Transaksi` INNER JOIN
                         tbltrans_do ON tbltrans_salesreturn.`Primary DO` = tbltrans_do.`Primary` INNER JOIN
                         tblmaster_customer ON tbltrans_do.`Primary Customer` = tblmaster_customer.`Primary` INNER JOIN
                         tblmaster_customer_sales_area ON tblmaster_customer.`Primary Sales Area` = tblmaster_customer_sales_area.`Primary` INNER JOIN
                         tblmaster_customer_segmentation ON tblmaster_customer.`Primary Customer Segmentasi` = tblmaster_customer_segmentation.`Primary`
WHERE        (tbltrans_salesreturn.`Tipe SR` = @TipeSR) AND (tbltrans_salesreturn.`Tanggal Transaksi` &lt;= @TanggalSampai) AND 
                         (tbltrans_salesreturn.`Tanggal Transaksi` &gt;= @TanggalDari)</CommandText>
