                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="False">
                    <CommandText>SELECT tbltrans_salesreturn.`Primary`, tbltrans_salesreturn.`No Transaksi` AS `SR No`, tbltrans_salesreturn.`Tanggal Transaksi` AS `SR Date`, tbltrans_salesreturn.`Primary Currency`, IFNULL(tblmaster_currency.`Currency Code`, '') 
                  AS `Currency Code`, IFNULL(tbltrans_so.`Primary Customer`, - 1) AS `Primary Customer`, tbltrans_salesreturn.`Primary Customer Quick`, IFNULL(tblmaster_customer_1.`Customer Code`, '-') AS `Customer Code`, 
                  IFNULL(tblmaster_customer_1.`Customer Name`, '-') AS `Customer Name`, IFNULL(tblmaster_customer.`Customer Code`, '-') AS `Customer Code Quick`, IFNULL(tblmaster_customer.`Customer Name`, '-') AS `Customer Name Quick`, 
                  tbltrans_salesreturn.`Payment Term`, IFNULL(tbltrans_so.`Primary`, - 1) AS `Primary SO`, IFNULL(tbltrans_so.`No Transaksi`, '-') AS `SO No`, tbltrans_salesreturn.`Tipe SR`, tbltrans_salesreturn_item.`Primary Product`, 
                  tblmaster_product.`Product Code`, tblmaster_product.Description AS `Product Desc`, tbltrans_salesreturn_item.`Primary Units`, tblmaster_master_unit.`Unit Code` AS `Unit Code Default`, tbltrans_salesreturn_item.`Primary Units Multi`, 
                  tblmaster_master_unit_1.`Unit Code` AS `Unit Code Multi`, tbltrans_salesreturn_item.`Total Qty Multi`, tblmaster_product.`Decimal`, tbltrans_salesreturn_item.`Nett Price`, tbltrans_salesreturn_item.Amount, 
                  tbltrans_salesreturn.`Sub Total`, tbltrans_salesreturn.`Tax Amount`, tbltrans_salesreturn.Total, IFNULL(tblmaster_currency.`Default Precision`, 0) AS `Default Precision`, tbltrans_salesreturn.`Created By`, 
                  tblmaster_product.`Primary Category`, product_sub_brand_view.`Primary Brand`, product_sub_brand_view.`Primary Sub Brand`, tblmaster_product_group.`Parent Group Primary` AS `Primary Group`, 
                  tbltrans_salesreturn.`Invoice Cancellation`, tbltrans_salesreturn_item.`Ratio Reference`, tbltrans_salesreturn_item.`Ratio Default`, tbltrans_salesreturn.`Primary Curr Tax`, IFNULL(tblmaster_currency_1.`Currency Code`, '') 
                  AS `Currency Code Tax`, IFNULL(tblmaster_currency_1.`Default Precision`, 0) AS `Default ``Precision`` Tax`, tbltrans_salesreturn.`Tax Percent`, tbltrans_salesreturn.`Tax Exchange Rate`, tbltrans_salesreturn.`Duty stamp`, 
                  tbltrans_salesreturn_item.`price by multi unit`, IFNULL(tblmaster_product_item_multiunit.`Default Precision`, tblmaster_product.`Decimal`) AS `Dec Multi`, tbltrans_salesreturn_item.`Total Qty`
FROM     tbltrans_salesreturn_item INNER JOIN
                  tbltrans_salesreturn ON tbltrans_salesreturn_item.`Primary Transaksi` = tbltrans_salesreturn.`Primary` INNER JOIN
                  tblmaster_master_unit ON tbltrans_salesreturn_item.`Primary Units` = tblmaster_master_unit.`Primary` INNER JOIN
                  tblmaster_master_unit tblmaster_master_unit_1 ON tbltrans_salesreturn_item.`Primary Units Multi` = tblmaster_master_unit_1.`Primary` LEFT OUTER JOIN
                  tblmaster_currency tblmaster_currency_1 ON tbltrans_salesreturn.`Primary Curr Tax` = tblmaster_currency_1.`Primary` LEFT OUTER JOIN
                  tbltrans_so ON tbltrans_salesreturn_item.`Primary SO` = tbltrans_so.`Primary` LEFT OUTER JOIN
                  tblmaster_customer tblmaster_customer_1 ON tbltrans_so.`Primary Customer` = tblmaster_customer_1.`Primary` LEFT OUTER JOIN
                  tblmaster_product_item_multiunit ON tbltrans_salesreturn_item.`Primary Units Multi` = tblmaster_product_item_multiunit.`Primary Unit` AND 
                  tbltrans_salesreturn_item.`Primary Product` = tblmaster_product_item_multiunit.`Primary Product` LEFT OUTER JOIN
                  tblmaster_customer ON tbltrans_salesreturn.`Primary Customer Quick` = tblmaster_customer.`Primary` LEFT OUTER JOIN
                  tblmaster_currency ON tbltrans_salesreturn.`Primary Currency` = tblmaster_currency.`Primary` LEFT OUTER JOIN
                  tblmaster_category INNER JOIN
                  tblmaster_product ON tblmaster_category.`Primary` = tblmaster_product.`Primary Category` INNER JOIN
                  product_sub_brand_view ON tblmaster_category.`Parent Group Primary` = product_sub_brand_view.`Primary Sub Brand` INNER JOIN
                  tblmaster_product_group ON product_sub_brand_view.`Primary Brand` = tblmaster_product_group.`Primary` ON tbltrans_salesreturn_item.`Primary Product` = tblmaster_product.`Primary`
WHERE  (tbltrans_salesreturn.`Tanggal Transaksi` &gt;= @StartDate) AND (tbltrans_salesreturn.`Tanggal Transaksi` &lt;= @EndDate)
ORDER BY `SR Date`, `SR No`, tblmaster_product.`Product Code`</CommandText>
