            tbltrans_so.`Primary Customer`, tblmaster_customer.`Customer Code`, tblmaster_customer.`Customer Name`, tbltrans_so.`No Transaksi` AS `So Number`, tbltrans_so.`Tanggal Transaksi` AS `SO Date`, 
