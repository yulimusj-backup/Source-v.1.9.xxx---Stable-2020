                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="True">
                    <CommandText>SELECT tbltrans_purchasereturn.`Primary`, tbltrans_purchasereturn.`No Transaksi` AS `PR No`, tbltrans_purchasereturn.`Tanggal Transaksi` AS `PR Date`, tbltrans_purchasereturn.`Primary Currency`, 
                 IFNULL(tblmaster_currency_1.`Currency Code`, '') AS `Currency Code`, tbltrans_purchasereturn.`primary supplier`, tblmaster_supplier.`Supplier Code`, tblmaster_supplier.`Supplier Name`, 
                 tbltrans_purchasereturn.`Payment Term`, tbltrans_purchasereturn_item.`Primary PO`, IFNULL(tbltrans_po.`No Transaksi`, '-') AS `PO No`, tbltrans_purchasereturn.`Tipe PR`, 
                 tbltrans_purchasereturn_item.`Primary Product`, tblmaster_product.`Product Code`, tblmaster_product.Description AS `Product Desc`, tbltrans_purchasereturn_item.`Primary Units`, 
                 tblmaster_master_unit_1.`Unit Code` AS `Unit Code Default`, tbltrans_purchasereturn_item.`Primary Unit Multi`, tblmaster_master_unit.`Unit Code` AS `Unit Code Multi`, tbltrans_purchasereturn_item.`Total Qty Multi`, 
                 tblmaster_product.`Decimal`, tbltrans_purchasereturn_item.`Nett Price`, tbltrans_purchasereturn_item.Amount, tbltrans_purchasereturn.`Sub Total`, tbltrans_purchasereturn.`Tax Amount`, 
                 tbltrans_purchasereturn.Total, IFNULL(tblmaster_currency_1.`Default Precision`, 0) AS `Default Precision`, tbltrans_purchasereturn.`Created By`, tblmaster_product.`Primary Category`, 
                 product_sub_brand_view.`Primary Sub Brand`, product_sub_brand_view.`Primary Brand`, tblmaster_product_group.`Parent Group Primary` AS `Primary Group`, tbltrans_purchasereturn.`Invoice Cancellation`, 
                 tbltrans_purchasereturn_item.`Ratio Reference`, tbltrans_purchasereturn_item.`Ratio Default`, IFNULL(tblmaster_product_item_multiunit.`Default Precision`, 0) AS `Decimal Multi`, 
                 tbltrans_purchasereturn.`Primary Curr Tax`, IFNULL(tblmaster_currency.`Currency Code`, '') AS `Currency Code Tax`, IFNULL(tblmaster_currency.`Default Precision`, 0) AS `Currency Default ``Precision`` Tax`, 
                 tbltrans_purchasereturn.Tax, tbltrans_purchasereturn.`Tax Exchange Rate`, tbltrans_purchasereturn_item.`Total Qty` AS `Total Qty Default`, tbltrans_purchasereturn_item.`price by multi unit`
FROM    tbltrans_purchasereturn INNER JOIN
                 tbltrans_purchasereturn_item ON tbltrans_purchasereturn.`Primary` = tbltrans_purchasereturn_item.`Primary Transaksi` INNER JOIN
                 tblmaster_supplier ON tbltrans_purchasereturn.`primary supplier` = tblmaster_supplier.`Primary` INNER JOIN
                 tblmaster_product ON tbltrans_purchasereturn_item.`Primary Product` = tblmaster_product.`Primary` INNER JOIN
                 tblmaster_master_unit ON tbltrans_purchasereturn_item.`Primary Unit Multi` = tblmaster_master_unit.`Primary` INNER JOIN
                 tblmaster_category ON tblmaster_product.`Primary Category` = tblmaster_category.`Primary` INNER JOIN
                 product_sub_brand_view ON tblmaster_category.`Parent Group Primary` = product_sub_brand_view.`Primary Sub Brand` INNER JOIN
                 tblmaster_product_group ON product_sub_brand_view.`Primary Brand` = tblmaster_product_group.`Primary` INNER JOIN
                 tblmaster_master_unit tblmaster_master_unit_1 ON tbltrans_purchasereturn_item.`Primary Units` = tblmaster_master_unit_1.`Primary` LEFT OUTER JOIN
                 tblmaster_currency ON tbltrans_purchasereturn.`Primary Curr Tax` = tblmaster_currency.`Primary` LEFT OUTER JOIN
                 tblmaster_product_item_multiunit ON tbltrans_purchasereturn_item.`Primary Unit Multi` = tblmaster_product_item_multiunit.`Primary Unit` AND 
                 tbltrans_purchasereturn_item.`Primary Product` = tblmaster_product_item_multiunit.`Primary Product` LEFT OUTER JOIN
                 tbltrans_po ON tbltrans_purchasereturn_item.`Primary PO` = tbltrans_po.`Primary` LEFT OUTER JOIN
                 tblmaster_currency tblmaster_currency_1 ON tbltrans_purchasereturn.`Primary Currency` = tblmaster_currency_1.`Primary`
WHERE (tbltrans_purchasereturn.`Tanggal Transaksi` &gt;= @StartDate) AND (tbltrans_purchasereturn.`Tanggal Transaksi` &lt;= @EndDate)
ORDER BY `PR Date`, `PR No`, tblmaster_product.`Product Code`</CommandText>
