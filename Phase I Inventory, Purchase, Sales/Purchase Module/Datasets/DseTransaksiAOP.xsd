                    <CommandText>SELECT tblmaster_product.`Product Code`, tblmaster_product.Description, tbltrans_po.`No Transaksi` AS `PO No`, tbltrans_grn.`No Transaksi` AS `GRN No`, IFNULL(tbltransaksi_stockinout.`No Transaksi`, '') 
