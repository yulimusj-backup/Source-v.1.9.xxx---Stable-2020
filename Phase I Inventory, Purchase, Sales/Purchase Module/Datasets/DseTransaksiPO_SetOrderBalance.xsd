                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="True">
                    <CommandText>SELECT        authorized_po_view.`Primary` AS `Primary PO`, authorized_po_view.`Primary Supplier`, tbltrans_po_item_view0.`Primary Product`, 
                         tblmaster_product.`Product Code`, authorized_po_view.`No Transaksi` AS `PO Number`, 
                         tbltrans_po_item_view0.Qty + IFNULL(SUM(orderbalance_report_return_item_view.`Total Qty`), 0) 
                         - IFNULL(SUM(orderbalance_report_goods_in_transit_view1.`Total Qty`), 0) - IFNULL(SUM(orderbalance_report_grnitem_view.`Total Qty`), 0) 
                         - IFNULL(SUM(orderbalance_report_item_poc_view.`Total Qty`), 0) AS OrderBalance
FROM            authorized_po_view INNER JOIN
                         tbltrans_po_item_view0 ON authorized_po_view.`Primary` = tbltrans_po_item_view0.`Primary Transaksi` INNER JOIN
                         tblmaster_product ON tbltrans_po_item_view0.`Primary Product` = tblmaster_product.`Primary` LEFT OUTER JOIN
                         orderbalance_report_goods_in_transit_view1 ON authorized_po_view.`Primary` = orderbalance_report_goods_in_transit_view1.`Primary PO` AND 
                         tbltrans_po_item_view0.`Primary Product` = orderbalance_report_goods_in_transit_view1.`Primary Product` LEFT OUTER JOIN
                         orderbalance_report_return_item_view ON authorized_po_view.`Primary` = orderbalance_report_return_item_view.`Primary PO` AND 
                         tbltrans_po_item_view0.`Primary Product` = orderbalance_report_return_item_view.`Primary Product` LEFT OUTER JOIN
                         orderbalance_report_grnitem_view ON tbltrans_po_item_view0.`Primary Product` = orderbalance_report_grnitem_view.`Primary Product` AND 
                         authorized_po_view.`Primary` = orderbalance_report_grnitem_view.`Primary PO` LEFT OUTER JOIN
                         orderbalance_report_item_poc_view ON tbltrans_po_item_view0.`Primary Product` = orderbalance_report_item_poc_view.`Primary Product` AND 
                         authorized_po_view.`Primary` = orderbalance_report_item_poc_view.`Primary PO`
GROUP BY authorized_po_view.`Primary`, authorized_po_view.`Primary Supplier`, tbltrans_po_item_view0.`Primary Product`, tblmaster_product.`Product Code`, 
                         authorized_po_view.`No Transaksi`, orderbalance_report_goods_in_transit_view1.`Total Qty`, authorized_po_view.`Tanggal Transaksi`
ORDER BY authorized_po_view.`Tanggal Transaksi`, `PO Number`, tblmaster_product.`Product Code`</CommandText>
