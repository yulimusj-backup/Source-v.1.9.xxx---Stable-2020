                    <CommandText>SELECT        tbltrans_aop.`No Transaksi` AS `AOP No`, tbltrans_aop.`Tanggal Transaksi` AS `Date`, ROUND(tbltrans_aop.`Sub Total` * tbltrans_aop.`Tax Exchange Rate`, 
