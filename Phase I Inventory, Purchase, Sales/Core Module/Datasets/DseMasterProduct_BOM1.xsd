                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="True">
                    <CommandText>SELECT        tblmaster_product.`Primary` AS `Primary Product`, tblmaster_product.`Product Code`, tblmaster_product.Description AS `Product Desc`, tblmaster_product.`Primary Proses` AS `Primary Process`, 
                         tblmaster_proses.Code AS `Process Code`, tblmaster_proses.`Desc` AS `Process Desc`, tblmaster_product.`Qty Ref`, tblmaster_product.`Decimal` AS `Default ``Precision```, tblmaster_product.`Primary Unit`, 
                         tblmaster_master_unit.`Unit Code`, tblmaster_master_unit.Description AS `Unit Desc`, tblmaster_product.`Good Precentage` AS `GP Process`, 
                         tblmaster_product.`production tolerance` AS `Tolerance Process`
FROM            tblmaster_product INNER JOIN
                         tblmaster_master_unit ON tblmaster_product.`Primary Unit` = tblmaster_master_unit.`Primary` INNER JOIN
                         tblmaster_proses ON tblmaster_product.`Primary Proses` = tblmaster_proses.`Primary`
WHERE        (tblmaster_product.`Product Code` LIKE @product_code) AND (tblmaster_product.Description LIKE @product_desc)
ORDER BY tblmaster_product.`Product Code`, `Product Desc`, `Process Code`, tblmaster_master_unit.`Unit Code`, `Process Desc`</CommandText>
