                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="False">
                    <CommandText>SELECT        tblmaster_customer.`Primary`, tblmaster_customer.`Customer Code`, tblmaster_customer.`Customer Name`, tblmaster_customer.`NPWP No`, 
                         tblmaster_customer.`Nama Jalan`, tblmaster_customer.Blok, tblmaster_customer.Nomor, tblmaster_customer.RT, tblmaster_customer.RW, 
                         tblmaster_customer.Kelurahan, tblmaster_customer.Kecamatan, tblmaster_customer.Kabupaten, tblmaster_customer.Propinsi, 
                         tblmaster_customer.`Primary Customer Group`, tblmaster_customer.`Primary Sales Area`, tblmaster_customer.`Primary Customer Segmentasi`, 
                         tblmaster_customer.`Primary Customer Type`, IFNULL(tblmaster_customer_group.`Customer Group Code`, '') AS `Customer Group Code`, 
                         IFNULL(tblmaster_customer_group.Description, '') AS `Customer Group Desc`, IFNULL(tblmaster_customer_sales_area.`Sales Area Code`, '') AS `Sales Area Code`, 
                         IFNULL(tblmaster_customer_sales_area.Description, '') AS `Sales Area Desc`, IFNULL(tblmaster_customer_segmentation.`Segmentation Code`, '') 
                         AS `Segmentation Code`, IFNULL(tblmaster_customer_segmentation.Description, '') AS `Segmentation Desc`, IFNULL(tblmaster_customer_type.`Type Code`, '') 
                         AS `Type Code`, IFNULL(tblmaster_customer_type.Description, '') AS `Type Desc`
FROM            tblmaster_customer LEFT OUTER JOIN
                         tblmaster_customer_type ON tblmaster_customer.`Primary Customer Type` = tblmaster_customer_type.`Primary` LEFT OUTER JOIN
                         tblmaster_customer_segmentation ON tblmaster_customer.`Primary Customer Segmentasi` = tblmaster_customer_segmentation.`Primary` LEFT OUTER JOIN
                         tblmaster_customer_sales_area ON tblmaster_customer.`Primary Sales Area` = tblmaster_customer_sales_area.`Primary` LEFT OUTER JOIN
                         tblmaster_customer_group ON tblmaster_customer.`Primary Customer Group` = tblmaster_customer_group.`Primary`</CommandText>
