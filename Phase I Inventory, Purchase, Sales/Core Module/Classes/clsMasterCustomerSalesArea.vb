Option Explicit On
Option Strict Off

Public Class clsMasterCustomerSalesArea
    Dim ObjCD As New Core_Module.ClsCekData

    Dim mPrimary As Double = -1
    Dim mCustomerSalesAreaCode As String = ""
    Dim mDescription As String = ""
    ''' <summary>
    ''' nilai Customer type level silakan start dari 1
    ''' </summary>
    ''' <remarks></remarks>
    Dim mCreatedBy As String = ""
    Dim mCreatedDate As Date = Now
    Dim mModifiedBy As String = ""
    Dim mModifiedDate As Date = Now
    Dim mTimestamp As Date = Now

    Public Property Primary() As Double
        Get
            Return mPrimary
        End Get
        Set(ByVal value As Double)
            mPrimary = value
        End Set
    End Property

    Public Property CustomerSalesAreaCode() As String
        Get
            Return Me.mCustomerSalesAreaCode
        End Get
        Set(ByVal value As String)
            mCustomerSalesAreaCode = value
        End Set
    End Property

    Public Property Description() As String
        Get
            Return Me.mDescription
        End Get
        Set(ByVal value As String)
            mDescription = value
        End Set
    End Property

